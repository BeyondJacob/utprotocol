# Database Configuration
# For Docker: Use the PostgreSQL service hostname
# For local development: Use localhost
DATABASE_URL=postgres://utprotocol:utprotocol_password@postgres:5432/utprotocol

# Ollama Configuration
# For Docker: Use host.docker.internal to access host machine's Ollama
# For local development: Use localhost
OLLAMA_URL=http://host.docker.internal:11434

# Logging Level
# Options: error, warn, info, debug, trace
RUST_LOG=info

# Server Configuration (Optional - overrides config.toml)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=3001

# Frontend Configuration (Optional)
# NEXT_PUBLIC_API_URL=http://localhost:3001
